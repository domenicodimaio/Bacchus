# 🔧 CONFIGURAZIONE REVENUECAT - ESEMPIO
# Copia questo file in .env e inserisci le tue chiavi reali

# 🍎 iOS RevenueCat API Key
# Ottieni da: https://app.revenuecat.com/projects/YOUR_PROJECT/api-keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_IOS_KEY_HERE

# 🤖 Android RevenueCat API Key  
# Ottieni da: https://app.revenuecat.com/projects/YOUR_PROJECT/api-keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_ANDROID_KEY_HERE

# 🔐 IMPORTANTE:
# 1. Non committare mai il file .env con chiavi reali
# 2. Aggiungi .env al .gitignore
# 3. Usa variabili d'ambiente in EAS Build per produzione